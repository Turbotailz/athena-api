{
  "name": "overwatch-hero-api",
  "version": "2.19.1",
  "license": "MIT",
  "description": "An open API to fetch Overwatch Hero data, for the base game and Stadium modes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Turbotailz/overwatch-hero-api.git"
  },
  "main": "dist/npm/src/lib.js",
  "types": "dist/npm/src/lib.d.ts",
  "files": [
    "dist/npm"
  ],
  "exports": {
    ".": "./dist/npm/src/lib.js",
    "./data": "./dist/npm/src/data/db.js"
  },
  "type": "module",
  "bin": {
    "overwatch-hero-api": "dist/npm/src/mcp.js",
    "overwatch-mcp": "dist/npm/src/mcp.js"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run build-data && npm run build:lib && nuxt build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "deploy": "npm run build && wrangler pages deploy .output/public",
    "build-data": "tsx scripts/process-data.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "predeploy": "npm run build-data"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.76",
    "@iconify-json/simple-icons": "^1.2.60",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@nuxt/content": "^3.8.2",
    "@nuxt/eslint": "^1.11.0",
    "@nuxt/icon": "^2.1.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.2.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "better-sqlite3": "^12.4.6",
    "eslint": "^9.39.1",
    "hono": "^4.0.0",
    "nuxt": "^4.2.1",
    "nuxt-llms": "^0.1.3",
    "nuxt-og-image": "^5.1.12",
    "vue-tsc": "^3.1.5",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^20.19.25",
    "ts-node": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^3.0.0"
  }
}
